{
  "name": "technova-operations",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/run-apps.mjs dev",
    "dev:frontend": "npm run dev --workspace @nexus/frontend",
    "dev:backend": "npm run dev --workspace @nexus/backend",
    "build": "npm run build --workspaces",
    "start": "node scripts/run-apps.mjs start",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:backend": "npm run test:backend --workspace @nexus/backend",
    "db:generate": "npm run db:generate --workspace @nexus/backend",
    "db:validate": "npm run db:validate --workspace @nexus/backend",
    "db:migrate": "npm run db:migrate --workspace @nexus/backend",
    "db:dev": "npm run db:dev --workspace @nexus/backend",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:check": "npm run setup:check --workspace @nexus/backend --",
    "jobs:run": "npm run jobs:run --workspace @nexus/backend",
    "auth:configure": "npm run auth:configure --workspace @nexus/backend --",
    "db:backup": "npm run db:backup --workspace @nexus/backend --",
    "db:restore-check": "npm run db:restore-check --workspace @nexus/backend --",
    "test:ops": "npm run test:ops --workspace @nexus/backend",
    "test:live": "npm run test:live --workspace @nexus/backend"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
