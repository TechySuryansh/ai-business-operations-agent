{
  "name": "@nexus/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "node ../scripts/start-service.mjs backend",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts*",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "test:backend": "node --conditions=react-server --import tsx tests/backend/integration.ts",
    "setup:check": "node scripts/preflight.mjs",
    "jobs:run": "node scripts/run-jobs.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "db:backup": "node scripts/database-backup.mjs backup",
    "db:restore-check": "node scripts/database-backup.mjs restore-check",
    "test:ops": "node --test tests/operations.test.mjs",
    "test:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "next": "^16.0.0",
    "openai": "7.57.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
