# Copy to backend/.env. Never commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Exact frontend origin; open the frontend using this same hostname.
APP_URL=http://127.0.0.1:3000
# Random secret of at least 32 characters for scheduled job execution.
CRON_SECRET=

# Optional: enables OpenAI; blank keeps the clearly labeled ledger-rule fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set to groq to use Groq instead of OpenAI.
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
